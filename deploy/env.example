# Example production environment for systemd EnvironmentFile=
# Copy to your runtime directory as .env (mode 600). Never commit real values.
#
# ENV_FILE (if set in the process environment) must point at this same file path
# so the WebUI setup wizard writes the file systemd reloads on restart.

HOST=127.0.0.1
PORT=4331
# Public HTTPS origin of this app (used by SvelteKit)
ORIGIN=https://voice.example.com
NODE_ENV=production

VOICE_URL_KEY=
XAI_API_KEY=
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_KEY=agent:main:voice

# First-run wizard (optional). With SETUP_TOKEN set and SETUP_COMPLETE unset,
# open https://voice.example.com/setup?token=… then restart after save.
# SETUP_TOKEN=
# SETUP_COMPLETE=
# ENV_FILE=/opt/hermes-voice/.env
