# Example production environment for systemd EnvironmentFile= or Compose env_file.
# Copy to your runtime directory as .env (mode 600). Never commit real values.
#
# ENV_FILE (if set) must point at this same file path so the WebUI setup wizard
# writes the file the process reloads on restart (systemd) or the mounted path (Compose).

HOST=127.0.0.1
PORT=4331
# Public HTTPS origin of this app (used by SvelteKit)
ORIGIN=https://voice.example.com
NODE_ENV=production

VOICE_URL_KEY=
XAI_API_KEY=

# Voice realtime provider: xai (default) | openai. Ops switch — not per-user.
# VOICE_PROVIDER=xai
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_VOICE=alloy

HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_KEY=agent:main:voice

# First-run wizard (optional). With SETUP_TOKEN set and SETUP_COMPLETE unset,
# open https://voice.example.com/setup?token=… then restart after save.
# SETUP_TOKEN=
# SETUP_COMPLETE=
# ENV_FILE=/opt/hermes-voice/.env
# Compose example mounts repo .env at /app/.env — then use:
# ENV_FILE=/app/.env

# Multi-user (optional). After single-user setup, set MULTI_USER=1 or use
# /owner/users → Enable. N users ≈ N Hermes profiles — see docs/OPS.md.
# MULTI_USER=
# BINDINGS_FILE=/opt/hermes-voice/data/bindings.json
# Compose example:
# BINDINGS_FILE=/app/data/bindings.json
