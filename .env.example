# Shared URL gate (?k= and /api/*). Copy to .env and set real values.
# Never commit .env.
VOICE_URL_KEY=change-me-to-a-long-random-string

# Server-only. Used to mint ephemeral xAI realtime client secrets. Never expose to the browser.
XAI_API_KEY=

# Hermes Agent bridge (server-only). Never expose to the browser.
# HERMES_API_KEY must match Hermes API_SERVER_KEY on your Hermes instance.
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_SESSION_KEY=agent:main:voice

# --- First-run WebUI setup (optional) ---
# Bootstrap: leave SETUP_COMPLETE unset/empty, set a random SETUP_TOKEN, start the app,
# open /setup?token=<SETUP_TOKEN>, complete the wizard, then restart.
# SETUP_COMPLETE=1 hard-locks bootstrap; SETUP_TOKEN is ignored when complete.
# SETUP_TOKEN=
# SETUP_COMPLETE=

# Path to the env file the wizard writes (default: <cwd>/.env).
# Must be the same path as systemd EnvironmentFile= (e.g. /opt/hermes-voice/.env).
# ENV_FILE=
